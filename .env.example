# ==========================================================
# 1. MODELO E CREDENCIAIS GOOGLE AI / VERTEX AI
# ==========================================================
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=sua_chave_aqui
# GOOGLE_CLOUD_PROJECT=projeto-sabor-da-terra
# GOOGLE_CLOUD_LOCATION=global

# ==========================================================
# 2. BANCO DE DADOS OPERACIONAL (PostgreSQL / Cloud SQL)
# ==========================================================
# Opções de backend: "postgres" (padrão) ou "csv" (fallback local)
SABOR_DATA_BACKEND=postgres

# Em ambiente local: 127.0.0.1 (porta 5432 ou 5433 via Cloud SQL Auth Proxy)
# No Cloud Run: /cloudsql/PROJETO:REGIAO:INSTANCIA
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sabor_terra
DB_USER=sabor_app
DB_PASSWORD=senha_local_de_exemplo

# Opcional: URI completa de conexão (se preenchida, sobrepõe DB_HOST..DB_PASSWORD)
# DATABASE_URL=postgresql+psycopg://sabor_app:senha_local_de_exemplo@127.0.0.1:5432/sabor_terra

# ==========================================================
# 3. SEGURANÇA, SESSÃO E CRIPTOGRAFIA LGPD
# ==========================================================
# Segredo para assinar tokens HMAC da API e derivar chave Fernet de criptografia LGPD
SABOR_AUTH_SECRET=troque_por_um_segredo_forte_de_32_bytes
# Opcional: chave dedicada para criptografia de colunas sensíveis (CPF, PIX, conta)
SABOR_DB_ENCRYPTION_KEY=
